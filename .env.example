# Reference only: supply actual values through the process/hosting environment.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_BOOTSTRAP_PASSWORD
ADMIN_FULL_NAME=Administrator
TASK_UPLOAD_DIR=/data/private-uploads
# Optional server-to-server integration. Leave unset to disable the API.
# Generate two DIFFERENT random tokens, each at least 32 characters.
CRM_API_READ_TOKEN=
CRM_API_WRITE_TOKEN=
